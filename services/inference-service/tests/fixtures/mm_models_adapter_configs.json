  "surya-ocr": {
    "inputs": [
      {
        "dtype": "BYTES",
        "shape": [
          -1,
          1
        ],
        "tensor": "IMAGE_DATA",
        "value_path": "input.image_content"
      }
    ],
    "model_version": "1",
    "outputs": [
      {
        "dtype": "BYTES",
        "maps_to": "text",
