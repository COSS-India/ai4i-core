  "transliteration": {
    "inputs": [
      {
        "dtype": "BYTES",
        "shape": [
          -1
        ],
        "tensor": "INPUT_TEXT",
        "value_path": "input.source"
      },
      {
        "dtype": "BYTES",
        "shape": [
          -1
        ],
