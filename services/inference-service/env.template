# Inference Service Environment Configuration Template
# Copy this file to .env and update the values

# Service Configuration
SERVICE_NAME=inference-service
HOST=0.0.0.0
PORT=8090
WORKERS=2
LOG_LEVEL=INFO
DEBUG=false

# API Configuration
API_PREFIX=/api/v1
API_TITLE=AI4I Inference Service
API_DESCRIPTION=Unified inference endpoint for NMT, ASR, OCR, NER, LLM and other task services

# Database Configuration (Optional - for future use)
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=<POSTGRES_HOST>
POSTGRES_PORT=<POSTGRES_PORT>
POSTGRES_DB=core_db

# Redis Configuration (Optional - for caching)
CACHE_TTL_SECONDS=300

# Model Management Service (Required)
# Platform Core Service runs natively on port 8095
MODEL_MANAGEMENT_SERVICE_URL=http://localhost:8095
MODEL_MANAGEMENT_SERVICE_TIMEOUT=30

# Triton Inference Server Configuration
DEFAULT_TRITON_TIMEOUT=60

# Load-test stub mode. When true, Triton and LLM upstream calls are replaced by
# canned responses from response_test/, so a load test measures orchestrator
# overhead with no model in the loop. Leave false for normal operation.
TRITON_STUB_MODE=false

# Per-block phase timing. Each request's root span gains per-stage *_ms fields
# (resolve, validate, preprocess, build_payload, triton, output_convert,
# output_tokens, postprocess) and a "TIMING ..." line is logged per request.
# Set to false to silence.
PHASE_TIMING_ENABLED=true

# OpenAI-compatible LLM proxy
# Endpoint resolution is handled via MMS using the serviceId from the request.
# Set MODEL_MANAGEMENT_SERVICE_URL above so the resolver can reach MMS.
LLM_INFERENCE_TIMEOUT=60

# SmartModelRouter Configuration (Optional - for routing)
SMR_SERVICE_TIMEOUT=30

# Telemetry (OpenTelemetry spans → stdout + optional Kafka → OpenSearch)
ENABLE_TELEMETRY=true

# Jaeger OTLP HTTP endpoint mapped to host port 4318
# Do not set OTEL_EXPORTER_OTLP_ENDPOINT to Jaeger; traces use Kafka
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Kafka Configuration (OTel span export)
# Off by default — bare `docker compose up` doesn't run a broker, and a false
# value keeps kafka-python out of the startup path entirely (no DNS retries,
# no log storm). Flip to true when running `--profile logging` or
# `--profile streaming` so OTel spans get shipped to Kafka for Fluent Bit →
# OpenSearch ingestion (i.e. the Logs Dashboard / traceability stack).
KAFKA_ENABLED=false
KAFKA_TOPIC_OTEL_TRACE=kafka-topic-otel-trace
# Kafka mapped to host port 9093
KAFKA_SERVER=localhost:9093

# Observability (AI4ICore Observability Plugin)
# Enables /enterprise/metrics + per-request Prometheus tracking.
# The middleware reads `task_type` from the inference payload to label
# metrics by task (nmt, asr, ocr, ner, llm, tts, transliteration, etc.).
OBSERVE_UTIL_ENABLED=true
OBSERVE_UTIL_DEBUG=false
OBSERVE_UTIL_METRICS_PATH=/enterprise/metrics

# API docs exposure — set false in production (OWASP API8)
ENABLE_DOCS=true
# Comma-separated CORS origins; wildcard disables credentialed requests
CORS_ALLOW_ORIGINS=*
# SSRF guard override — allow audio/image URI downloads from private hosts (dev only)
ALLOW_PRIVATE_DOWNLOAD_HOSTS=false
