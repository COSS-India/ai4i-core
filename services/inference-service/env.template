# Inference Service Environment Configuration Template
# Copy this file to .env and update the values

# Service Configuration
SERVICE_NAME=inference-service
HOST=0.0.0.0
PORT=8090
WORKERS=2
LOG_LEVEL=INFO
DEBUG=false

# API Configuration
API_PREFIX=/api/v1
API_TITLE=AI4I Inference Service
API_DESCRIPTION=Unified inference endpoint for NMT, ASR, OCR, NER, LLM and other task services

# Database Configuration (Optional - for future use)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=core_db
# DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/core_db
# DATABASE_POOL_SIZE=10
# DATABASE_ECHO=false

# Redis Configuration (Optional - for caching)
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
CACHE_TTL_SECONDS=300

# Model Management Service (Required)
MODEL_MANAGEMENT_SERVICE_URL=http://platform-core-service:8095
MODEL_MANAGEMENT_SERVICE_TIMEOUT=30

# Triton Inference Server Configuration
DEFAULT_TRITON_TIMEOUT=60

# OpenAI-compatible LLM proxy
# Base URL of the upstream LLM server (e.g. vLLM, llama.cpp, Ollama-compat).
# Routes /api/v1/chat/completions and /api/v1/chat forward to this base
# by appending /v1/chat/completions and /v1/chat respectively.
LLM_DEFAULT_ENDPOINT=<YOUR_LLM_UPSTREAM_BASE_URL>
# Optional per-model overrides as JSON, e.g.:
# LLM_MODEL_ENDPOINTS={"google/gemma-4-E4B-it":"http://10.0.0.5:8000"}
LLM_MODEL_ENDPOINTS={}
LLM_INFERENCE_TIMEOUT=60

# SmartModelRouter Configuration (Optional - for routing)
# SMR_SERVICE_URL=http://smr-service:8097
SMR_SERVICE_TIMEOUT=30

# Telemetry exporter configuration (Optional - for tracing)
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:8090

# Kafka Configuration (Optional - for event streaming)
KAFKA_TOPIC_OTEL_TRACE=kafka-topic-otel-trace
KAFKA_SERVER=localhost:9092

# Observability (AI4ICore Observability Plugin)
# Enables /enterprise/metrics + per-request Prometheus tracking.
# The middleware reads `task_type` from the inference payload to label
# metrics by task (nmt, asr, ocr, ner, llm, tts, transliteration, etc.).
OBSERVE_UTIL_ENABLED=true
OBSERVE_UTIL_DEBUG=false
OBSERVE_UTIL_METRICS_PATH=/enterprise/metrics

# API docs exposure — set false in production (OWASP API8)
ENABLE_DOCS=true
# Comma-separated CORS origins; wildcard disables credentialed requests
CORS_ALLOW_ORIGINS=*
# SSRF guard override — allow audio/image URI downloads from private hosts (dev only)
ALLOW_PRIVATE_DOWNLOAD_HOSTS=false
