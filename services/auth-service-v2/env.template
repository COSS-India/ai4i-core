# ── Auth Service v2 Configuration ──

# Service
SERVICE_NAME=auth-service
SERVICE_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<AUTH_DB_NAME>
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_DB_API_PERMISSIONS=0
REDIS_DB_ROLE_PERMISSIONS=1
REDIS_DB_API_KEYS=2
REDIS_DB_REFRESH_TOKENS=3
REDIS_TIMEOUT=10

# Cache TTLs (seconds)
ROLE_CACHE_TTL_SECONDS=31536000
API_PERMS_CACHE_TTL_SECONDS=31536000

# ── RS256 JWT Keys ──
# Directory containing RSA key pair PEM files
# In dev: auto-generates if empty
RS256_KEY_DIRECTORY=keys
RS256_MIN_KEY_COUNT=10
RS256_ACTIVE_KEY_INDEX=0

# ── JWT Claims ──
JWT_ISSUER=auth-service
# JWT_AUDIENCE=  # Optional: set if audience verification needed

# ── Token Expiry ──
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_EXPIRE_DAYS=365

# ── Password Hashing ──
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
DEFAULT_HASH_ROUNDS=12

# ── CORS ──
CORS_ORIGINS=*

# ── OAuth2 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=
# Comma-separated allowlist of allowed client redirect URIs after OAuth login.
# Prevents open redirect / token leakage. REQUIRED if OAuth is enabled.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,https://app.example.com/auth/callback

# ── Observability ──
JAEGER_ENDPOINT=
TELEMETRY_ENABLED=true

# ── Swagger ──
SWAGGER_SERVER_URL=
