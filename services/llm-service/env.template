# LLM Service Environment Configuration Template
# Copy this file to `.env` in this directory and edit values there. The service reads
# **`.env`** (and process env) at runtime — **not** `.env.example` (documentation only).

# Service Configuration
SERVICE_NAME=llm-service
SERVICE_VERSION=1.0.0
SERVICE_PORT=8090
LOG_LEVEL=INFO

# Log Filtering Configuration
EXCLUDE_HEALTH_LOGS=true
EXCLUDE_METRICS_LOGS=true
EXCLUDE_OPTIONS_LOGS=true
ALLOWED_LOG_LEVELS=INFO,ERROR
MIN_LOG_LEVEL=INFO
INCLUDE_4XX_LOGS=false

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<AUTH_DB_NAME>
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# Triton Inference Server Configuration
TRITON_ENDPOINT=
TRITON_API_KEY=your_triton_api_key_here
TRITON_TIMEOUT=300
TRITON_CONCURRENCY=20
INFERENCE_SSL_VERIFY=true

# Direct inference upstream (bypasses model management; caller sends model in JSON).
# JSON map of model name → upstream base URL. Routes append /v1/chat/completions or /v1/completions.
# Example: {"llama-3-8b":"http://10.0.0.5:8001","mistral-7b":"http://10.0.0.6:8001"}
LLM_MODEL_ENDPOINTS={}
# Fallback base URL used when the requested model is not in LLM_MODEL_ENDPOINTS.
LLM_DEFAULT_ENDPOINT=
INFERENCE_TIMEOUT=60

# LLM Service Configuration
MAX_BATCH_SIZE=100
MAX_TEXT_LENGTH=50000
DEFAULT_INPUT_LANGUAGE=en
DEFAULT_OUTPUT_LANGUAGE=en

# Supported Languages (comma-separated)
SUPPORTED_LANGUAGES=en,hi,ta,te,kn,ml,bn,gu,mr,pa,or,as,ur

# Authentication Configuration
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://auth-service:8081
JWT_ISSUER=auth-service
# JWT_AUDIENCE=
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>
JWT_ALGORITHM=HS256
API_KEY_CACHE_TTL=300
SESSION_TIMEOUT_SECONDS=3600

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Security Configuration
ALLOW_ANONYMOUS_ACCESS=false
REQUIRE_API_KEY=true


# PII Guardrail — redact LLM source/output text before persisting to DB (HTTP response unchanged).
# Redaction runs only for languages the guardrail supports: en, hi, mr, ta. Leave empty to disable.
PII_SERVICE_URL=http://pii-guard-service:8000
# PII_REDACT_TIMEOUT=20

# Model Management Service Configuration
MODEL_MANAGEMENT_SERVICE_URL=http://model-management-service:8091
MODEL_MANAGEMENT_SERVICE_API_KEY=
MODEL_MANAGEMENT_CACHE_TTL=300

# Optional: pre-flight health gate (config-service /internal/health-status)
# When enabled, inference fails fast with 503 if target backend is unhealthy/unknown.
MODEL_MANAGEMENT_HEALTH_GATE_ENABLED=false
MODEL_MANAGEMENT_HEALTH_GATE_TIMEOUT_SECONDS=1.0
MODEL_MANAGEMENT_HEALTH_GATE_CACHE_TTL_SECONDS=3.0

# Logging Configuration (AI4ICore Logging)
USE_KAFKA_LOGGING=false

# Telemetry/Tracing Configuration (AI4ICore Telemetry - OpenTelemetry/Jaeger)
JAEGER_ENDPOINT=http://jaeger:4317
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Multi-tenant database (for tenant-specific schema routing)
# This is where llm request/result tables are stored in tenant schemas
MULTI_TENANT_DB_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<MULTI_TENANT_DB_NAME>
# Tenant Resolution Configuration
API_GATEWAY_URL=http://api-gateway-service:8080
TENANT_PATHS=/api/v1
MULTI_TENANT_ENABLED=true

# ── Pay-per-use billing (authenticated ``/api/v1/llm/inference`` and OpenAI proxy
# ``/api/v1/chat/completions`` / ``/api/v1/completions``) ──
# Runtime loads values from this repo file after you copy it:
#   cp env.template .env   (in services/llm-service/)
# The process reads **.env** (and the real process environment). It does **not**
# read `.env.example` — that file is documentation only.
#
# Master switch: false disables check/record entirely (no HTTP to PPU service).
LLM_PPU_ENABLED=true
# Base URL of pay-per-use-service (same env name as other services).
PAY_PER_USE_SERVICE_URL=http://pay-per-use-service:8006
# Service id sent to pay-per-use for rate/quota lookup (no Model Management call in LLM).
# Service id for /check and /record — must match tenant plan allowed_services (e.g. llm), not a model name.
LLM_PPU_SERVICE_ID=llm
# Tier label for observability / future DB-backed pricing.
LLM_PPU_BILLING_TIER=Tier-2
# When > 0, sent to pay-per-use ``/record`` as ``cost_per_unit`` (overrides plan/Redis/MM rate for that call).
# Set to 0 to omit and use tenant plan ``allowed_services`` pricing only.
LLM_PPU_COST_PER_TOKEN=0.02
