# Loaded by docker compose (env_file). Secrets and DB names stay in compose `environment:` / root `.env`.
# Copy `env.template` to `.env` for local `uvicorn` runs or optional overrides.
PYTHONUNBUFFERED=1
# PII Guardrail — redact source/target text before writing to DB.
# Leave empty to disable redaction (raw text stored).
PII_SERVICE_URL=http://pii-guard-service:8000
PII_REDACT_TIMEOUT=20
