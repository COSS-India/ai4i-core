# Feedback Service — Environment Variables
# Copy this file to .env and fill in the values.

# Service
SERVICE_NAME=feedback-service
PORT=8100

# Database — feedback service's own store
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<FEEDBACK_DB_NAME>

# NMT source database — read-only connection to fetch translations for evaluation
# This is the same AUTH_DB that nmt-service writes its requests/results into.
NMT_DB_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<AUTH_DB_NAME>

# Auth
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://auth-service:8081
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
JWT_ISSUER=<YOUR_JWT_ISSUER>
JWT_AUDIENCE=<YOUR_JWT_AUDIENCE>

# PII Guardrail — called before any user text is written to the database
PII_SERVICE_URL=http://pii-guard-service:8000

# LLM Judge
LLM_JUDGE_URL=http://ollama:11434/api/generate
LLM_JUDGE_MODEL=llama3:8b

# Config service
CONFIG_SERVICE_URL=http://config-service:8082
