# ── Platform-core DB (usage_events, daily_usage, ...) ──
# Credentials fall back to POSTGRES_* if the PLATFORM_CORE_DB_* vars are unset.
PLATFORM_CORE_DB_NAME=ai4iplatform_core
PLATFORM_CORE_DB_USER=<POSTGRES_USER>
PLATFORM_CORE_DB_PASSWORD=<POSTGRES_PASSWORD>
PLATFORM_CORE_DB_HOST=<POSTGRES_HOST>
PLATFORM_CORE_DB_PORT=<POSTGRES_PORT>

# ── Auth DB (tenants, applications, api keys) ──
# Credentials fall back to POSTGRES_* if the AUTH_DB_* vars are unset.
AUTH_DB_USER=<POSTGRES_USER>
AUTH_DB_PASSWORD=<POSTGRES_PASSWORD>
AUTH_DB_HOST=<POSTGRES_HOST>
AUTH_DB_PORT=<POSTGRES_PORT>
AUTH_SERVICE_DB_NAME=ai4iplatform_auth

# Pool sizes per engine. A job is one short-lived process, so keep them small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Monthly partitions (daily_usage) ──
# Months created ahead of the current one.
PARTITION_MONTHS_AHEAD=3

# ── Daily partitions (usage_events) ──
# Days created ahead of today.
USAGE_EVENTS_DAYS_AHEAD=7

# ── daily_usage rollup ──
# Closed days re-rolled before yesterday, to pick up late events.
USAGE_ROLLUP_LOOKBACK_DAYS=2

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10

# ── Platform-core internal API (only for jobs that call /internal/*) ──
PLATFORM_CORE_SERVICE_URL=http://localhost:8095

# Must match platform-core's INTERNAL_SERVICE_SHARED_SECRET (sent as X-Internal-Service-Token).
INTERNAL_SERVICE_SHARED_SECRET=<INTERNAL_SERVICE_SHARED_SECRET>

# Per-request timeout for the internal calls, in seconds.
INTERNAL_HTTP_TIMEOUT_SECONDS=300

# ── usage_backfill (one-off, run by hand: Prometheus → daily_usage) ──
PROMETHEUS_URL=http://localhost:9090
# Label carrying the HTTP path on telemetry_obsv_requests_total: exported_endpoint behind a
# ServiceMonitor (k8s), endpoint on local docker-compose — platform-core's value.
PROMETHEUS_API_PATH_LABEL=exported_endpoint
PROMETHEUS_TIMEOUT_SECONDS=60
# export: Prometheus → file; load: file → daily_usage; all: both.
USAGE_BACKFILL_MODE=all
# Written by export, read by load. Keep it: Prometheus can't reproduce days it has dropped.
USAGE_BACKFILL_FILE=usage_backfill.json
# First IST day (YYYY-MM-DD). Unset → the first whole day Prometheus retains.
# USAGE_BACKFILL_FROM=
# Export up to this instant (ISO 8601). Unset → the first usage_events row.
# USAGE_BACKFILL_UNTIL=

# ── usage_report ──
# Report frequency: monthly, or any duration — 1d, 7d, 14d, 3d … (units m h d w). Config only:
# no code change for a new value. Run the CronJob ONCE PER PERIOD, just after it ends (weekly:
# Mondays; monthly: the 1st): every run sends the latest period again, so change the schedule
# together with this value. Under a day (30m, 2h …) is for test environments only (platform-core
# needs USAGE_REPORT_ALLOW_SUBDAILY=true), a few minutes after each block (e.g. "5,35 * * * *").
USAGE_REPORT_FREQUENCY=monthly
