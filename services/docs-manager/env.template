# ── Docs Manager — environment template ───────────────────────────────────────
# Copy to .env and fill in values. Variables marked REQUIRED have no default.

# REQUIRED — Base URL of the API Gateway.
# Used as the server URL in Swagger UI "Try it out". Must be reachable from
# the browser (not from inside Docker/K8s).
# Docker local:  http://localhost:8080
# Dev K8s:       https://dev.ai4inclusion.org
API_GATEWAY_URL=

# Hostname suffix appended to every service hostname in spec_url values.
# Controls where docs-manager fetches /openapi.json from at startup.
#
# Leave empty (default) for:
#   - Docker Compose          → http://ner-service:9001  (works as-is)
#   - K8s same namespace      → http://ner-service:9001  (works as-is)
#
# Set for cross-namespace K8s:
#   SERVICES_HOST_SUFFIX=.dev.svc.cluster.local
#   → http://ner-service.dev.svc.cluster.local:9001/openapi.json
#
SERVICES_HOST_SUFFIX=

# Absolute path to the service registry YAML (optional).
# Default: <service_root>/specs/service-docs-registry.yaml
# SERVICE_DOCS_REGISTRY_PATH=/app/specs/service-docs-registry.yaml
