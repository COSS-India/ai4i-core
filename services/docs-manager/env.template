# Docs Manager – environment template
# Copy to .env and adjust as needed. All variables are optional (defaults work for local dev).

# Base URL of the API Gateway. This is the server URL shown in the OpenAPI spec; "Try it out"
# in Swagger UI sends requests to this URL (e.g. from the browser when docs are at same origin).
# Docker: when docs are at http://localhost:8080/docs via gateway, use API_GATEWAY_URL=http://localhost:8080
API_GATEWAY_URL=http://localhost:8080

# Absolute path to the service docs registry YAML file. The registry lists which
# services to include and their spec_file paths.
# Default: <service_dir>/specs/service-docs-registry.yaml
# SERVICE_DOCS_REGISTRY_PATH=/app/specs/service-docs-registry.yaml

# Root directory for resolving spec_file paths from the registry (e.g. asr-service.yaml).
# Default: <service_dir>/specs
# SPECS_ROOT=/app/specs
