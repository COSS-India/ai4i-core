{# details: [tier_name, changes, effective_date], or with a 4th element
   (the list of institution names) for the Adopter Admin's one consolidated
   copy spanning several institutions #}
{% set layout = "notification" %}
{% set name = "Quota Limit Updated" %}
{% set headline = "The Quota Limit for " ~ tenant_name ~ " has been updated." %}
{% set lines = [{"label": "Tier", "value": details[0]}] + details[1]
    + [{"label": "Effective Date", "value": details[2]}]
    + ([{"label": "Institutions"}] + details[3] if details|length > 3 else []) %}
