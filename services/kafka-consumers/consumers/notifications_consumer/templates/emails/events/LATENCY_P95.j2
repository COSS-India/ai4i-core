{# details: [threshold, alert_datetime, current_value, service_id, affected_services]
   — bare numbers, unit appended by the layout. affected_services, sent when several
   services fired in one tick, is [[service_id, current_value, threshold], ...], worst
   first; the four values before it are the worst service's. An envelope published
   before service_id was added has three and renders without the service. #}
{% set layout = "monitoring_alert" %}
{% set name = "P95 Latency" %}
{% set unit = "s" %}
{% set threshold = details[0] %}
{% set alert_datetime = details[1] %}
{% set current_value = details[2] %}
{% set affected_service = details[3] if details | length > 3 else "" %}
{% set affected_services = details[4] if details | length > 4 else [] %}
