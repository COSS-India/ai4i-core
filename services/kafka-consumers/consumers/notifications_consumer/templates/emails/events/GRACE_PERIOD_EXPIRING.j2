{# details: [application_name, api_key, expires_on, days_left] #}
{% set layout = "notification" %}
{% set days_left = details[3] %}
{% set when = "today" if days_left == 0 else ("in 1 day" if days_left == 1 else "in " ~ days_left ~ " days") %}
{% set name = "Action required: Old API key for " ~ details[0] ~ " will be revoked " ~ when %}
{% set headline = "The old API key for " ~ details[0] ~ " will expire " ~ when ~ ", on " ~ details[2] ~ "." %}
{% set lines = [
    "API Key Rotation Details",
    {"label": "Application", "value": details[0]},
    {"label": "Old API Key Identifier", "value": details[1]},
    {"label": "New API Key Identifier", "value": details[1]},
    {"label": "Days Remaining", "value": days_left},
    {"label": "Expiry Date", "value": details[2]},
    "Action Required",
    "Please ensure that the application is updated to use the new API key before the old key expires. Any application still using the old key will lose access after its expiry.",
    "For security reasons, this email does not include the API key values.",
] %}
