{# details: [application_name, api_key, created_on, expires_on, days_left] #}
{% set layout = "notification" %}
{% set days_left = details[4] %}
{% set when = "today" if days_left == 0 else ("in 1 day" if days_left == 1 else "in " ~ days_left ~ " days") %}
{% set time_remaining = "Less than a day" if days_left == 0 else ("1 day" if days_left == 1 else days_left ~ " days") %}
{% set name = "Action required: API key for " ~ details[0] ~ " expires " ~ when %}
{% set headline = "The API key " ~ details[1] ~ " for " ~ details[0] ~ " expires " ~ when ~ ", on " ~ details[3] ~ "." %}
{% set lines = [
    "Key details",
    {"label": "Institution", "value": tenant_name},
    {"label": "Application", "value": details[0]},
    {"label": "Key identifier", "value": details[1]},
    {"label": "Created on", "value": details[2]},
    {"label": "Expires on", "value": details[3]},
    {"label": "Time remaining", "value": time_remaining},
    "What you need to do: Requests using this key will fail after it expires. Please create a new key, or extend this one, and move the Application to it before " ~ details[3] ~ ".",
    "For security reasons, this email does not include the API key value.",
] %}
