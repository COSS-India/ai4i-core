# Kafka broker
KAFKA_SERVER=localhost:9093

# New consumer group (§10 / README "Adding a consumer" step 5): must be
# 'error', not 'earliest' — this group has no committed offsets yet, and
# 'earliest' would silently replay the whole topic from the beginning the
# first time this consumer starts. Do not copy this value from another
# consumer's shared .env once this becomes a real handler.
KAFKA_AUTO_OFFSET_RESET=error

# Disable auto-commit; the consumer commits explicitly after each handler call
KAFKA_ENABLE_AUTO_COMMIT=false

# Broker marks consumer dead if no heartbeat within this window (ms)
KAFKA_SESSION_TIMEOUT_MS=30000

# Max time between consecutive poll() calls before a rebalance is triggered (ms)
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Seconds to block on each Consumer.poll() call
KAFKA_POLL_TIMEOUT_S=1.0

# Messages requested per consume() call — leave at 1, see bootstrap/config.py
KAFKA_BATCH_SIZE=1

# Kafka topic this consumer subscribes to — placeholder, not final
TOPIC_NOTIFICATION=notification.events

# ── Database ──
# Only ai4iplatform_core, for notification_alert_failure_log rows
# (failures.py). No connection to ai4iplatform_auth.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PLATFORM_CORE_DB=ai4iplatform_core
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
# One SET NX claim per event_id (handler.py) — skips a Kafka redelivery of
# an event already handled.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10
REDIS_MAX_CONNECTIONS=50

# Pod identity on notification_alert_failure_log rows (pod_name); falls
# back to HOSTNAME when unset.
# POD_NAME=

# ── Branding (single place with simple-ui / auth-service — AI4IDS-3043) ──
# Set PLATFORM_NAME + ADOPTER_LOGO_URL once in the repo root .env;
# ./scripts/setup-env.sh copies them here.
# Name: every email's title, header, footer, portal line and sign-off.
# Logo: absolute http(s) URL only; empty ⇒ text brand mark in the header.
# Required — no default in code; the consumer will not start if this is blank.
PLATFORM_NAME=<PLATFORM_NAME>
ADOPTER_LOGO_URL=<ADOPTER_LOGO_URL>

# ── Email (ai4i_core.email — see emailer.py / email_templates.py) ──
EMAIL_PROVIDER=console
EMAIL_FROM=notifications@example.com
# SMTP From-header display name (independent of PLATFORM_NAME). Leave empty
# to inherit PLATFORM_NAME at provider construction.
EMAIL_FROM_NAME=<PLATFORM_NAME>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Network timeout for one SMTP send attempt (ai4i_core.email default: 30s).
# emailer.py's own outer deadline (_send_deadline_s()) is derived from this
# value plus headroom, so raising it here also raises that.
SMTP_TIMEOUT=60
ENVIRONMENT=development

# Same setting as platform-core-service's settings.portal_url. Linked from
# every rendered email's "_portal_line.html" include when set; left unset
# falls back to unlinked plain text ("Log in to the ... Portal to ...").
PORTAL_URL=http://localhost:3000
