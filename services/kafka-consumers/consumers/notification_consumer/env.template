# Kafka broker
KAFKA_SERVER=localhost:9093

# New consumer group (§10 / README "Adding a consumer" step 5): must be
# 'error', not 'earliest' — this group has no committed offsets yet, and
# 'earliest' would silently replay the whole topic from the beginning the
# first time this consumer starts. Do not copy this value from another
# consumer's shared .env once this becomes a real handler.
KAFKA_AUTO_OFFSET_RESET=error

# Disable auto-commit; the consumer commits explicitly after each handler call
KAFKA_ENABLE_AUTO_COMMIT=false

# Broker marks consumer dead if no heartbeat within this window (ms)
KAFKA_SESSION_TIMEOUT_MS=30000

# Max time between consecutive poll() calls before a rebalance is triggered (ms)
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Seconds to block on each Consumer.poll() call
KAFKA_POLL_TIMEOUT_S=1.0

# Messages requested per consume() call — leave at 1, see bootstrap/config.py
KAFKA_BATCH_SIZE=1

# Kafka topic this consumer subscribes to — placeholder, not final
TOPIC_NOTIFICATION=notification.events

# ── Database ── (infra() opens this even though the handler is a no-op today)
POSTGRES_USER=admin
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PLATFORM_CORE_DB=ai4iplatform_core
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10
REDIS_MAX_CONNECTIONS=50
