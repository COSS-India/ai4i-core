# Kafka broker
KAFKA_SERVER=localhost:9093

# Offset reset policy when no committed offset exists: 'error', 'earliest' or 'latest'
KAFKA_AUTO_OFFSET_RESET=error

# Disable auto-commit; BaseKafkaConsumer commits explicitly after handle_message()
KAFKA_ENABLE_AUTO_COMMIT=false

# Broker marks consumer dead if no heartbeat within this window (ms)
KAFKA_SESSION_TIMEOUT_MS=30000

# Max time between consecutive poll() calls before a rebalance is triggered (ms)
KAFKA_MAX_POLL_INTERVAL_MS=300000

# Seconds to block on each Consumer.poll() call
KAFKA_POLL_TIMEOUT_S=1.0

# Kafka topic for pay-per-use usage events
TOPIC_PAY_PER_USE=kafka-topic-otel-trace

# ── Notification producer (QUOTA_THRESHOLD/BUDGET_THRESHOLD/
# QUOTA_EXHAUSTED/BUDGET_EXHAUSTED, published post-commit per billing
# message) — matches the notification.events topic
# infrastructure/kafka/local-init-kafka.sh creates automatically. ──
TOPIC_NOTIFICATION=notification.events
NOTIFICATION_PRODUCER_ENABLED=true

# Base URL of auth-service (internal network)
AUTH_SERVICE_URL=http://localhost:8081

# ── Database ──
# Second database (ai4iplatform_auth) _billing.fetch_tenant_budget_status
# reads directly (tenants.allocated_budget + the tenant's api_key ids, for
# BUDGET_THRESHOLD/BUDGET_EXHAUSTED's now-tenant-level check), over the SAME
# connection credentials as PLATFORM_CORE_DB below — one Postgres instance,
# two databases. See main.py's add_database() call.
AUTH_SERVICE_DB=ai4iplatform_auth
POSTGRES_USER=admin
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PLATFORM_CORE_DB=ai4iplatform_core
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# users.email in ai4iplatform_auth is encrypted at rest (AES-SIV) — this MUST
# be the exact same value auth-service's own PII_ENCRYPTION_KEY is set to.
# Handed to ai4i_core.pii_crypto.configure_key() at startup (main.py) so
# ai4i_core.kafka.recipients can decrypt an email when resolving a
# QUOTA_THRESHOLD/QUOTA_EXHAUSTED/BUDGET_THRESHOLD/BUDGET_EXHAUSTED
# notification's recipients. Left unset (the default), every encrypted
# users.email row fails to decrypt, resolve_recipients returns [] for it,
# and the notification is silently dropped — no PPU email goes out.
PII_ENCRYPTION_KEY=

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10
REDIS_MAX_CONNECTIONS=50
