# ──────────────────────────────────────────────────────────────────────────────
# Request Profiler Service – environment template
# Copy this file to .env and fill in the values before running the service.
# ──────────────────────────────────────────────────────────────────────────────

# Port the service listens on inside the container
PORT=8000

# ── Upstream profiler API ──────────────────────────────────────────────────────
# Full URL of the external profiler endpoint.
# The service POSTs { "options": {...}, "source_lang": "...", "text": "..." }
# to this URL and returns the response verbatim.
PROFILER_API_URL=http://13.201.140.42:8000/api/v1/profile

# Default source language sent to the upstream API (ISO 639-1 code)
PROFILER_SOURCE_LANG=en

# Timeout (seconds) for upstream profiler HTTP requests
PROFILER_REQUEST_TIMEOUT=30

# ── Service identity ───────────────────────────────────────────────────────────
SERVICE_NAME=request-profiler-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
