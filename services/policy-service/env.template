# Basic environment template for policy-service
SERVICE_NAME=policy-service
HOST=0.0.0.0
PORT=8099
LOG_LEVEL=info

# Database connection settings (aligned with other services using ai4icore_env)
# These will be composed into the SQLAlchemy URL internally.
APP_DB_USER=<POSTGRES_USER>
APP_DB_PASSWORD=<POSTGRES_PASSWORD>
APP_DB_HOST=<POSTGRES_HOST>
APP_DB_PORT=<POSTGRES_PORT>
APP_DB_NAME=policy

# Auth (JWT verification via JWKS)
# Option A: set JWKS_URL directly (recommended)
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json

# Multi-tenant (optional; used when tenant validation / global mapping is enabled)
MULTI_TENANT_SERVICE_URL=http://multi-tenant-service:8001

# Example placeholders for future use
# AUTH_PUBLIC_KEY_PATH=/app/keys/public.pem
# AUTH_REQUIRED=true

# Compose-local moved these from docker-compose-local.yml into the env file.
AUTH_SERVICE_URL=http://auth-service:8081
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
PYTHONPATH=/app:/app/libs/ai4icore_exceptions:/app/libs/ai4icore_auth:/app/libs
