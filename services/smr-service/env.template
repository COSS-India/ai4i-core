# SMR Service environment template

# Port the SMR service will listen on inside the container
PORT=8097

# Policy Engine URL
POLICY_ENGINE_URL=http://policy-engine:8095

# Model Management Service URL
# Note: MODEL_MANAGEMENT_SERVICE_URL is kept for backward compatibility but not used for DB operations
MODEL_MANAGEMENT_SERVICE_URL=http://model-management-service:8091

# Request Profiler Service URL
REQUEST_PROFILER_SERVICE_URL=http://request-profiler-service:8000

# Database connection settings (for direct DB access)
# When running locally (from host), use:
#   APP_DB_HOST=localhost
#   APP_DB_PORT=5434 (mapped port from docker-compose)
# When running in Docker container, use:
#   APP_DB_HOST=postgres
#   APP_DB_PORT=5432 (internal container port)
APP_DB_USER=dhruva_user
APP_DB_PASSWORD=dhruva_secure_password_2024
APP_DB_HOST=localhost
APP_DB_PORT=5434
APP_DB_NAME=model_management_db
