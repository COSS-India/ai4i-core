# Pay-per-use service — environment template
# Copy this file to `.env` in this same directory and adjust values for local runs.
# `env.template` is versioned; `.env` is gitignored.
#
# In Docker Compose, variables are usually injected via the service `environment:` block.
# A mounted `.env` file is optional and can override for dev-only tweaks.

# -----------------------------------------------------------------------------
# PostgreSQL (SQLAlchemy async — must use asyncpg driver in URL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pay_per_use_db

# -----------------------------------------------------------------------------
# Redis (rate/quota counters, pricing cache warm-up)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Policy engine — tenant plans, tiers, allowed_services, quotas
# -----------------------------------------------------------------------------
POLICY_ENGINE_URL=http://policy-engine:8095

# -----------------------------------------------------------------------------
# Multi-tenant service (policy / tenant resolution as needed)
# -----------------------------------------------------------------------------
MULTI_TENANT_URL=http://multi-tenant-service:8001

# -----------------------------------------------------------------------------
# Model management — billing fields (cost_per_unit, unit_type) for usage & dashboards
# -----------------------------------------------------------------------------
MODEL_MANAGEMENT_URL=http://model-management-service:8091

# -----------------------------------------------------------------------------
# HTTP port (uvicorn; Compose/Dockerfile typically use 8006)
# -----------------------------------------------------------------------------
PORT=8006
