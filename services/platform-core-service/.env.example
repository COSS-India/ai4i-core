# Platform Core Service Configuration Template
# Copy this file to .env and fill in your actual values

# Service Identity
SERVICE_NAME=platform-core-service
SERVICE_VERSION=1.0.0
API_VERSION=v1
DEBUG=false
HOST=0.0.0.0
PORT=8095
WORKERS=1
LOG_LEVEL=INFO

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=core_db

# Backwards-compatible aliases
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_NAME=core_db
CORE_DB_NAME=core_db

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=10

# Cache TTLs (in seconds)
MODEL_CACHE_TTL_SECONDS=3600
SERVICE_CACHE_TTL_SECONDS=3600

# Model Management
MAX_ACTIVE_VERSIONS_PER_MODEL=5
ALLOW_DEPRECATED_MODEL_CHANGES=true

# Endpoint Validation
RUN_INFERENCE_TEST=true
ENDPOINT_VALIDATION_TIMEOUT_SECONDS=15.0
ENDPOINT_VALIDATION_MODE=lenient
ENDPOINT_VALIDATION_SKIP_TLS_VERIFY=false

# Observability
TELEMETRY_ENABLED=true

# External services
AUTH_SERVICE_URL=http://localhost:8081
MODEL_MANAGEMENT_URL=
