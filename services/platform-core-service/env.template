# ── Platform Core Service Configuration ──

# Service identity
SERVICE_NAME=platform-core-service
SERVICE_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=INFO
# development | staging | production
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8095
WORKERS=1

# ── PostgreSQL ──
# Option 1: Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# Option 2: Individual fields (legacy-compatible APP_DB_* aliases also accepted)
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=<POSTGRES_HOST>
POSTGRES_PORT=<POSTGRES_PORT>
CORE_DB_NAME=ai4iplatform_core

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10

# Cache TTLs (seconds)
MODEL_CACHE_TTL_SECONDS=3600
SERVICE_CACHE_TTL_SECONDS=300
METERING_CACHE_TTL_SECONDS=60

# Metering dashboard auto-refresh interval (seconds) — sent to the UI so it knows how often to poll
METERING_REFRESH_INTERVAL_SECONDS=60

# Must match THIS deployment's actual Prometheus --storage.tsdb.retention.time
# — do not copy the value below as-is. model_usage_growth_pct's previous-month
# comparison needs up to ~60 days of history near month-end; if this is set
# higher than what Prometheus actually retains, the guard in config.py can't
# tell and will compute from pruned/partial data instead of returning null.
# Left unset here (falls back to config.py's conservative default of 15 —
# Prometheus's own out-of-box retention) so the guard stays safe until you
# explicitly set this to your real retention window.
# PROMETHEUS_RETENTION_DAYS=15

# ── Model management business rules ──
MAX_ACTIVE_VERSIONS_PER_MODEL=5
ALLOW_DEPRECATED_MODEL_CHANGES=true

# ── Endpoint validation ──
RUN_INFERENCE_TEST=true
ENDPOINT_VALIDATION_TIMEOUT_SECONDS=60.0
# lenient: accept <500  |  strict: accept <400
ENDPOINT_VALIDATION_MODE=lenient
ENDPOINT_VALIDATION_SKIP_TLS_VERIFY=false
# Accept model endpoints on private/reserved addresses. Enable only where the
# model fleet sits on trusted private infrastructure and service creation is
# restricted to trusted admins. Cloud metadata, loopback, link-local,
# unspecified, multicast and cluster-internal hostnames stay blocked either way.
ENDPOINT_VALIDATION_ALLOW_PRIVATE_HOSTS=false

# ── Observability ──
TELEMETRY_ENABLED=true

# ── PII: external GPU service endpoints ──
NER_SERVICE_URL=http://<ner-host>:<port>/ner
PII_LLM_URL=http://<llm-host>:<port>/api/query

# ── CORS ──
# Comma-separated origins. Use "*" to allow all.

# External services
AUTH_SERVICE_URL=http://localhost:8081
MODEL_MANAGEMENT_URL=

# ── Secondary auth DB (read-only — used by alert feature for RBAC/tenant lookups) ──
# Leave AUTH_DB_NAME blank to skip auth_db init (alert feature unavailable).
# AUTH_DB_* fields fall back to POSTGRES_* if unset.
AUTH_DB_NAME=ai4iplatform_auth
AUTH_DB_USER=<POSTGRES_USER>
AUTH_DB_PASSWORD=<POSTGRES_PASSWORD>
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432


# OpenSearch (Traces / Telemetry)
OPENSEARCH_URL=http://localhost:9204
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=traces-*

# ── Alert config sync (background reconciliation against Prometheus / Alertmanager) ──
# When ALERT_SYNC_ENABLED=true (default), the sync background task does NOT start.
# Flip to true once the alert tables exist (alembic upgrade head) and the paths below
# are reachable. Keep false during the side-by-side rollout window.
ALERT_SYNC_ENABLED=true
SYNC_INTERVAL=60
DEFAULT_RECEIVER_EMAILS=
#
# The alert-config output paths are RELATIVE to this service's working directory.
# In local dev the service runs natively with cwd=services/platform-core-service,
# so `../../infrastructure/...` resolves to the repo-root infrastructure/ folder
# (where Prometheus/Alertmanager read their config) — NOT a new infrastructure/
# folder inside platform-core-service. Override with absolute paths if you run
# this service from a different working directory.
PROMETHEUS_URL=http://localhost:9090
# Local docker-compose Prometheus (infrastructure/prometheus/prometheus.yml)
# scrapes via plain static_configs — no K8s ServiceMonitor, so no "endpoint"
# label collision, so the HTTP-path label stays "endpoint" here. Dev/staging/
# prod (K8s + Prometheus Operator) need PROMETHEUS_API_PATH_LABEL=exported_endpoint
# instead (the default — see app/core/config.py) because their ServiceMonitor's
# own "endpoint" label forces Prometheus to relabel the original to that.
PROMETHEUS_API_PATH_LABEL=endpoint
ALERTMANAGER_URL=http://localhost:9095
PROMETHEUS_APPLICATION_ALERTS_PATH=../../infrastructure/prometheus/rules/application-alerts.yml
PROMETHEUS_INFRASTRUCTURE_ALERTS_PATH=../../infrastructure/prometheus/rules/infrastructure-alerts.yml
ALERTMANAGER_CONFIG_PATH=../../infrastructure/alertmanager/alertmanager.yml
#
# URL that ALERTMANAGER (in docker) calls back to reach this service's history webhook.
# `inference-service` is a host-gateway alias defined in docker-compose-local.yml so that
# containers can reach services running natively on the host. Use the docker service name
# (http://platform-core-service:8095/...) instead if platform-core itself runs in docker.
ALERT_HISTORY_WEBHOOK_URL=http://localhost:8095/api/v1/alerts/history/webhook

# ── SMTP / SES (Alertmanager email delivery) ──
# Used by the Alertmanager config the sync loop writes out. For Amazon SES the
# smarthost is email-smtp.<region>.amazonaws.com:587 and the username/password
# are the SES SMTP credentials (NOT your IAM access key/secret directly).
SMTP_SMARTHOST=email-smtp.<region>.amazonaws.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=<YOUR_SMTP_USERNAME>
SMTP_AUTH_PASSWORD=<YOUR_SMTP_PASSWORD>
