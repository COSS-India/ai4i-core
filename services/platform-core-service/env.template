# ── Platform Core Service Configuration ──

# Service identity
SERVICE_NAME=platform-core-service
SERVICE_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=INFO

# ── PostgreSQL ──
# Option 1: Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# Option 2: Individual fields (legacy-compatible APP_DB_* aliases also accepted)
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CORE_DB_NAME=ai4iplatform_core

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10

# Cache TTLs (seconds)
MODEL_CACHE_TTL_SECONDS=3600
SERVICE_CACHE_TTL_SECONDS=3600

# ── Model management business rules ──
MAX_ACTIVE_VERSIONS_PER_MODEL=5
ALLOW_DEPRECATED_MODEL_CHANGES=true

# ── Endpoint validation ──
RUN_INFERENCE_TEST=true
ENDPOINT_VALIDATION_TIMEOUT_SECONDS=60.0
# lenient: accept <500  |  strict: accept <400
ENDPOINT_VALIDATION_MODE=lenient
ENDPOINT_VALIDATION_SKIP_TLS_VERIFY=false

# ── Observability ──
JAEGER_ENDPOINT=
TELEMETRY_ENABLED=true

# ── PII: external GPU service endpoints ──
NER_SERVICE_URL=http://<ner-host>:<port>/ner
PII_LLM_URL=http://<llm-host>:<port>/api/query

# ── CORS ──
# Comma-separated origins. Use "*" to allow all.

# External services
AUTH_SERVICE_URL=http://auth-service:8081
MODEL_MANAGEMENT_URL=

# ── Secondary auth DB (read-only — used by alert feature for RBAC/tenant lookups) ──
# Leave AUTH_DB_NAME blank to skip auth_db init (alert feature unavailable).
# AUTH_DB_* fields fall back to POSTGRES_* if unset.
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
AUTH_DB_HOST=
AUTH_DB_PORT=


# OpenSearch (Traces / Telemetry)
OPENSEARCH_URL=http://localhost:9204
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_INDEX=traces-*

# ── Alert config sync (background reconciliation against Prometheus / Alertmanager) ──
# When ALERT_SYNC_ENABLED=false (default), the sync background task does NOT start.
# Flip to true once the alert tables exist (alembic upgrade head) and the paths below
# are reachable. Keep false during the side-by-side rollout window.
ALERT_SYNC_ENABLED=false
SYNC_INTERVAL=60
DEFAULT_RECEIVER_EMAILS=
#
# The values below assume platform-core runs IN docker (reaches Prometheus/Alertmanager
# by service name; writes YAML into the volume-mounted container paths).
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
PROMETHEUS_APPLICATION_ALERTS_PATH=/etc/prometheus/rules/application-alerts.yml
PROMETHEUS_INFRASTRUCTURE_ALERTS_PATH=/etc/prometheus/rules/infrastructure-alerts.yml
ALERTMANAGER_CONFIG_PATH=/etc/alertmanager/alertmanager.yml
#
# URL that ALERTMANAGER (in docker) calls back to reach this service's history webhook.
# `inference-service` is a host-gateway alias defined in docker-compose-local.yml so that
# containers can reach services running natively on the host. Use the docker service name
# (http://platform-core-service:8095/...) instead if platform-core itself runs in docker.
ALERT_HISTORY_WEBHOOK_URL=http://inference-service:8095/api/v1/alerts/history/webhook
#
# ── Running platform-core ON THE HOST (outside docker) instead? Override with: ──
#   PROMETHEUS_URL=http://localhost:9090
#   ALERTMANAGER_URL=http://localhost:9095
#   PROMETHEUS_APPLICATION_ALERTS_PATH=<repo>/infrastructure/prometheus/rules/application-alerts.yml
#   PROMETHEUS_INFRASTRUCTURE_ALERTS_PATH=<repo>/infrastructure/prometheus/rules/infrastructure-alerts.yml
#   ALERTMANAGER_CONFIG_PATH=<repo>/infrastructure/alertmanager/alertmanager.yml
#   POSTGRES_HOST=localhost   (and AUTH_DB_HOST=localhost if auth_db is used)
