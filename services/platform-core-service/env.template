# ── Platform Core Service Configuration ──

# Service identity
SERVICE_NAME=platform-core-service
SERVICE_VERSION=1.0.0
API_VERSION=v1
LOG_LEVEL=INFO

# ── PostgreSQL ──
# Option 1: Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>

# Option 2: Individual fields (legacy-compatible APP_DB_* aliases also accepted)
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CORE_DB_NAME=ai4iplatform_core

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10

# Cache TTLs (seconds)
MODEL_CACHE_TTL_SECONDS=3600
SERVICE_CACHE_TTL_SECONDS=3600

# ── Model management business rules ──
MAX_ACTIVE_VERSIONS_PER_MODEL=5
ALLOW_DEPRECATED_MODEL_CHANGES=true

# ── Endpoint validation ──
RUN_INFERENCE_TEST=true
ENDPOINT_VALIDATION_TIMEOUT_SECONDS=60.0
# lenient: accept <500  |  strict: accept <400
ENDPOINT_VALIDATION_MODE=lenient
ENDPOINT_VALIDATION_SKIP_TLS_VERIFY=false

# ── Observability ──
JAEGER_ENDPOINT=
TELEMETRY_ENABLED=true

# ── PII Database (ai4i_platform — separate DB from ai4iplatform_core) ──
# Option 1: Full URL (takes precedence)
# PII_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:<port>/ai4i_platform

# Option 2: Individual fields
PII_DB_HOST=postgres
PII_DB_PORT=5432
PII_DB_USER=<POSTGRES_USER>
PII_DB_PASSWORD=<POSTGRES_PASSWORD>
PII_DB_NAME=ai4i_platform

PII_DB_POOL_SIZE=10
PII_DB_MAX_OVERFLOW=5

# ── PII: external GPU service endpoints ──
NER_SERVICE_URL=http://<ner-host>:<port>/ner
PII_LLM_URL=http://<llm-host>:<port>/api/query

# ── CORS ──
# Comma-separated origins. Use "*" to allow all.
