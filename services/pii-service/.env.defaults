# Loaded by docker compose (env_file). Secrets and DB names stay in compose `environment:` / root `.env`.
# Copy `env.template` to `.env` for local `uvicorn` or optional overrides (see compose `env_file` order).
PYTHONUNBUFFERED=1
DEV_MODE=false
AUTH_ENABLED=false
OTEL_SERVICE_NAME=pii-guardrail
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUDIT_TOPIC=pii_audit_logs
PII_HMAC_KEY=change-me-in-production
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
