# Copy to `.env` in this folder for local runs or extra Compose overrides:
#   cp env.template .env
#
# Docker Compose: uses `.env.defaults` (committed) + this file if present (see docker-compose env_file).
# DB user/password/name and REDIS password usually come from repo root `.env` via compose `environment:`.

PYTHONUNBUFFERED=1
DEV_MODE=false
AUTH_ENABLED=false

# Database (docker-compose network: host `postgres`, DB same as POSTGRES_DB in root .env)
DB_HOST=postgres
DB_NAME=ai4i_platform
DB_USER=admin
DB_PASS=changeme

REDIS_URL=redis://:changeme@redis:6379/0

# HMAC key for HASH action — set a strong random value in production
PII_HASH_KEY=changeme

NER_SERVICE_URL=http://13.206.126.62:8005/ner
LLM_SERVICE_URL=http://13.206.126.62:8000/api/query

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUDIT_TOPIC=pii_audit_logs

OTEL_SERVICE_NAME=pii-guardrail
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# Auth + RBAC (same stack as other services)
# - JWT: ai4icore_auth verifies RS256 tokens using JWKS from auth-service-v2
#   (deployed as `auth-service` in many environments).
# - RBAC: auth-service-v2 loads api_permissions.json → resolves permission names to DB IDs
#   and caches endpoint → permission_id in Redis key `auth:api_perms`.
#   PII's AuthProvider reads that map via PermissionChecker + checks JWT permission_ids.
# Set JWKS_URL explicitly, or AUTH_SERVICE_URL + JWKS_PATH (see build_jwt_verifier in ai4icore_auth).
AUTH_SERVICE_URL=http://auth-service:8081
JWKS_PATH=api/v1/auth/.well-known/jwks.json
# Prefer full URL if your gateway differs:
# JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
JWKS_URL=
JWT_ISSUER=auth-service
