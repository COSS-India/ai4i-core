# Copy to `.env` in this folder for local runs or extra Compose overrides:
#   cp env.template .env
#
# Docker Compose: uses `.env.defaults` (committed) + this file if present (see docker-compose env_file).
# DB user/password/name and REDIS password usually come from repo root `.env` via compose `environment:`.

PYTHONUNBUFFERED=1
DEV_MODE=false
AUTH_ENABLED=false

# Database (docker-compose network: host `postgres`, DB same as POSTGRES_DB in root .env)
DB_HOST=postgres
DB_NAME=ai4i_platform
DB_USER=admin
DB_PASS=changeme

REDIS_URL=redis://:changeme@redis:6379/0

NER_SERVICE_URL=http://127.0.0.1:9001/ner

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_AUDIT_TOPIC=pii_audit_logs
PII_HMAC_KEY=change-me-in-production

OTEL_SERVICE_NAME=pii-guardrail
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

AUTH_SERVICE_URL=http://auth-service:8081
JWKS_URL=
