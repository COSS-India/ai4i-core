# ── Auth Service v2 Configuration ──

# Service
SERVICE_NAME=auth-service
SERVICE_VERSION=2.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# PostgreSQL Configuration
AUTH_DB_USER=<POSTGRES_USER>
AUTH_DB_PASSWORD=<POSTGRES_PASSWORD>
AUTH_DB_HOST=<POSTGRES_HOST>
AUTH_DB_PORT=<POSTGRES_PORT>
AUTH_SERVICE_DB_NAME=ai4iplatform_auth
# Full URL override (optional — takes precedence over individual AUTH_DB_* vars above)
# DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/ai4iplatform_auth
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10
# Logical-DB layout per cache namespace
REDIS_DB_API_PERMISSIONS=0
REDIS_DB_ROLE_PERMISSIONS=1
REDIS_DB_API_KEYS=2
REDIS_DB_REFRESH_TOKENS=3

# Cache TTLs (seconds)
API_PERMS_CACHE_TTL_SECONDS=31536000
ROLE_CACHE_TTL_SECONDS=31536000

# ── RS256 JWT Keys ──
# Directory containing RSA key pair PEM files
# In dev: auto-generates if empty
RS256_KEY_DIRECTORY=keys
RS256_MIN_KEY_COUNT=10
RS256_ACTIVE_KEY_INDEX=0

# ── JWT Claims ──
JWT_ISSUER=auth-service
# JWT_AUDIENCE=  # Optional: set if audience verification needed

# ── OpenAPI / Swagger ──
# Public-facing base URL to advertise in the OpenAPI `servers` block. Leave
# blank to fall back to the request's own origin.
SWAGGER_SERVER_URL=

# ── Token Expiry ──
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY_EXPIRE_DAYS=365

# ── Password Hashing (Argon2id) ──
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
PASSWORD_HASH_MAX_WORKERS=50
# bcrypt rounds for the legacy/migration code path
DEFAULT_HASH_ROUNDS=12

# ── OAuth2 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=
# Comma-separated allowlist of allowed client redirect URIs after OAuth login.
# Prevents open redirect / token leakage. REQUIRED if OAuth is enabled.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback,https://app.example.com/auth/callback

# ── Observability ──
TELEMETRY_ENABLED=true

# ── Guest login (POST /api/v1/auth/guest/login; must match seed GUEST_EMAIL / GUEST_PASSWORD) ──
GUEST_EMAIL=guest@ai4inclusion.org
GUEST_PASSWORD=GUEST_PASSWORD

# ── Email ──
# Provider: smtp (default — works with SES, SendGrid, Mailgun, any SMTP relay)
# or console (dev fallback; auto-engaged when SMTP_HOST empty + ENVIRONMENT=development).
EMAIL_PROVIDER=smtp
EMAIL_FROM=
EMAIL_FROM_NAME=AI4I Platform
EMAIL_REPLY_TO=
# Optional JSON map. For Amazon SES Configuration Set:
# EMAIL_EXTRA_HEADERS={"X-SES-CONFIGURATION-SET":"my-config-set"}
EMAIL_EXTRA_HEADERS=

# SMTP transport. For Amazon SES: email-smtp.<region>.amazonaws.com
# For SendGrid: smtp.sendgrid.net (SMTP_USERNAME=apikey, SMTP_PASSWORD=<api-key>)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# SMTP network timeout (seconds) for one send attempt
SMTP_TIMEOUT=30

# Frontend URL where setup-link emails point (must be HTTPS)
SETUP_LINK_BASE_URL=https://app.example.com/auth/set-password

# Frontend URL for email-verification links (required for /auth/register flow).
# Same HTTPS rules as SETUP_LINK_BASE_URL; http://localhost only in development.
VERIFY_LINK_BASE_URL=https://app.example.com/auth/verify-email

# Frontend URL for password-reset links (required for /auth/forgot-password flow).
# Same HTTPS rules.
RESET_LINK_BASE_URL=https://app.example.com/auth/reset-password
# Reset-link expiry (minutes). Spec: 30 min.
RESET_TOKEN_EXPIRE_MINUTES=30
# Per-email rate limit for forgot-password requests. Spec: 3 / hour.
RESET_REQUEST_LIMIT_PER_HOUR=3

# ── PII field encryption (email / phone at rest) ──
# Base64- or hex-encoded AES-SIV key (decodes to 32/48/64 bytes; 64 = AES-256-SIV).
# Deterministic encryption so duplicate-email checks compare ciphertext directly.
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(64)).decode())"
# Rotating this key makes existing data unreadable.
PII_ENCRYPTION_KEY=<PII_ENCRYPTION_KEY>

# ── External services ──
# Platform-core service base URL (used by inter-service calls, if any)
#PLATFORM_CORE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@<POSTGRES_HOST>:<POSTGRES_PORT>/<DB>
# Secondary DB for PPU tier lookups at API key creation time.
# Set PLATFORM_CORE_DB_NAME to enable tier validation.
# Credentials fall back to POSTGRES_* if the PLATFORM_CORE_DB_* vars are unset.
PLATFORM_CORE_DB_NAME=ai4iplatform_core
PLATFORM_CORE_DB_USER=<POSTGRES_USER>
PLATFORM_CORE_DB_PASSWORD=<POSTGRES_PASSWORD>
PLATFORM_CORE_DB_HOST=<POSTGRES_HOST>
PLATFORM_CORE_DB_PORT=<POSTGRES_PORT>