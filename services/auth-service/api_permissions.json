{
  "description": "API endpoint -> permission mapping (single source of truth at runtime). permissionRequired is the permission name (resolved to its DB id at service startup). permissionRequired=null marks public endpoints. Permission and role seed data lives in infrastructure/databases/seeders, not here.",
  "apiMappings": [
    {
      "endpoint": "POST:/api/v1/auth/login",
      "permissionRequired": null,
      "description": "Login (public)"
    },
    {
      "endpoint": "POST:/api/v1/auth/guest/login",
      "permissionRequired": null,
      "description": "Guest login (public; GUEST_EMAIL and GUEST_PASSWORD env)"
    },
    {
      "endpoint": "POST:/api/v1/auth/register",
      "permissionRequired": null,
      "description": "Register (public; sends verify-email)"
    },
    {
      "endpoint": "POST:/api/v1/auth/verify-email",
      "permissionRequired": null,
      "description": "Verify email via token from registration email (public)"
    },
    {
      "endpoint": "POST:/api/v1/auth/resend-verification",
      "permissionRequired": null,
      "description": "Re-issue a verify-email link for users who registered but never verified (public)"
    },
    {
      "endpoint": "POST:/api/v1/auth/forgot-password",
      "permissionRequired": null,
      "description": "Request a password-reset email (public; rate-limited 3/hour/email)"
    },
    {
      "endpoint": "POST:/api/v1/auth/reset-password",
      "permissionRequired": null,
      "description": "Consume a reset token and set new password (public; revokes other sessions)"
    },
    {
      "endpoint": "POST:/api/v1/auth/refresh",
      "permissionRequired": null,
      "description": "Refresh token (public)"
    },
    {
      "endpoint": "GET:/api/v1/auth/validate",
      "permissionRequired": null,
      "description": "APISIX validation (internal)"
    },
    {
      "endpoint": "POST:/api/v1/auth/validate",
      "permissionRequired": null,
      "description": "APISIX validation (internal)"
    },
    {
      "endpoint": "POST:/api/v1/auth/validate-api-key",
      "permissionRequired": null,
      "description": "API key validation (internal)"
    },
    {
      "endpoint": "POST:/api/v1/auth/change-password",
      "permissionRequired": "users.update",
      "description": "Change password (requires users.update)"
    },
    {
      "endpoint": "POST:/api/v1/auth/sessions/revoke-by-tenant/{tenant_id}",
      "permissionRequired": null,
      "description": "Admin-only: revoke all sessions for a tenant"
    },
    {
      "endpoint": "POST:/api/v1/auth/sessions/revoke-by-users",
      "permissionRequired": null,
      "description": "Admin-only: revoke all sessions for selected users"
    },
    {
      "endpoint": "GET:/api/v1/auth/me",
      "permissionRequired": "users.read",
      "description": "Get own profile"
    },
    {
      "endpoint": "PUT:/api/v1/auth/me",
      "permissionRequired": "users.update",
      "description": "Update own profile"
    },
    {
      "endpoint": "GET:/api/v1/auth/users",
      "permissionRequired": "users.read",
      "description": "List users"
    },
    {
      "endpoint": "POST:/api/v1/users/create",
      "permissionRequired": "users.create",
      "description": "Create user (admin)"
    },
    {
      "endpoint": "DELETE:/api/v1/users/delete",
      "permissionRequired": "users.delete",
      "description": "Delete user (admin)"
    },
    {
      "endpoint": "POST:/api/v1/auth/roles/assign",
      "permissionRequired": "roles.assign",
      "description": "Assign role"
    },
    {
      "endpoint": "POST:/api/v1/auth/roles/remove",
      "permissionRequired": "roles.remove",
      "description": "Remove role"
    },
    {
      "endpoint": "GET:/api/v1/auth/roles/list",
      "permissionRequired": "roles.read",
      "description": "List roles"
    },
    {
      "endpoint": "GET:/api/v1/auth/roles/user/{user_id}",
      "permissionRequired": "roles.read",
      "description": "Get roles for a user"
    },
    {
      "endpoint": "POST:/api/v1/auth/roles/assign/guest/services",
      "permissionRequired": "roles.assign",
      "description": "Assign inference services to the GUEST role"
    },
    {
      "endpoint": "GET:/api/v1/auth/roles/list/guest/services",
      "permissionRequired": "roles.read",
      "description": "List inference services assigned to the GUEST role"
    },
    {
      "endpoint": "GET:/api/v1/auth/inference/permissions",
      "permissionRequired": "roles.read",
      "description": "List inference permissions"
    },
    {
      "endpoint": "POST:/api/v1/auth/api-keys",
      "permissionRequired": "apiKey.create",
      "description": "Create API key"
    },
    {
      "endpoint": "GET:/api/v1/auth/api-keys",
      "permissionRequired": "apiKey.read",
      "description": "List own API keys"
    },
    {
      "endpoint": "DELETE:/api/v1/auth/api-keys/{key_id}",
      "permissionRequired": "apiKey.delete",
      "description": "Revoke API key"
    },
    {
      "endpoint": "PATCH:/api/v1/auth/api-keys/{key_id}",
      "permissionRequired": "apiKey.update",
      "description": "Update API key"
    },
    {
      "endpoint": "GET:/api/v1/auth/oauth2/providers",
      "permissionRequired": null,
      "description": "List configured OAuth providers"
    },
    {
      "endpoint": "GET:/api/v1/auth/oauth2/{provider}/authorize",
      "permissionRequired": null,
      "description": "Begin OAuth login (provider redirect)"
    },
    {
      "endpoint": "GET:/api/v1/auth/oauth2/{provider}/callback",
      "permissionRequired": null,
      "description": "OAuth provider redirect target"
    },
    {
      "endpoint": "POST:/api/v1/auth/oauth2/exchange",
      "permissionRequired": null,
      "description": "Exchange one-time code for JWT pair"
    },
