    {
      "endpoint": "POST:/api/v1/nmt/inference",
      "permissionRequired": "nmt.inference",
      "description": "NMT inference"
    },
    {
      "endpoint": "POST:/api/v1/pipeline/inference",
      "permissionRequired": "pipeline.inference",
      "description": "Pipeline inference"
    },
    {
      "endpoint": "POST:/api/v1/llm/inference",
      "permissionRequired": "llm.inference",
      "description": "LLM inference"
    },
    {
      "endpoint": "POST:/api/v1/ocr/inference",
      "permissionRequired": "ocr.inference",
