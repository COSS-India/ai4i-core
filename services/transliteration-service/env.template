# Transliteration Service Environment Configuration Template
# Copy this file to .env and update the values

# Transliteration Service Configuration
SERVICE_NAME=transliteration-service
SERVICE_VERSION=1.0.0
SERVICE_PORT=8090
SERVICE_HOST=transliteration-service
SERVICE_PUBLIC_URL=
SERVICE_INSTANCE_ID=
CONFIG_SERVICE_URL=http://config-service:8082
LOG_LEVEL=INFO

# Log Filtering Configuration
EXCLUDE_HEALTH_LOGS=true
EXCLUDE_METRICS_LOGS=true
EXCLUDE_OPTIONS_LOGS=true
ALLOWED_LOG_LEVELS=INFO,ERROR
MIN_LOG_LEVEL=INFO
INCLUDE_4XX_LOGS=false

# Note: Logs are sent to OpenSearch via Fluent Bit (reads from Docker stdout)
# No Kafka configuration needed - services write JSON logs to stdout
# Fluent Bit automatically collects and forwards to OpenSearch

# PostgreSQL Configuration
DATABASE_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/auth_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# Triton Inference Server Configuration
TRITON_ENDPOINT=http://triton-server:8000
TRITON_API_KEY=your_triton_api_key_here
TRITON_TIMEOUT=20
TRITON_CONCURRENCY=20

# Transliteration Service Configuration
MAX_BATCH_SIZE=100
MAX_TEXT_LENGTH=10000
DEFAULT_SOURCE_LANGUAGE=en
DEFAULT_TARGET_LANGUAGE=hi

# Text Processing Configuration
ENABLE_TEXT_NORMALIZATION=true
ENABLE_SCRIPT_DETECTION=true

# Supported Languages (comma-separated)
SUPPORTED_LANGUAGES=en,hi,ta,te,kn,ml,bn,gu,mr,pa,or,as,ur,sa,ks,ne,sd,kok,doi,mai,brx,mni,sat,gom

# Authentication Configuration
AUTH_ENABLED=true
AUTH_SERVICE_URL=http://auth-service:8081
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
API_KEY_CACHE_TTL=300
SESSION_TIMEOUT_SECONDS=3600

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
RATE_LIMIT_PER_DAY=10000

# Security Configuration
ALLOW_ANONYMOUS_ACCESS=false
REQUIRE_API_KEY=true

# Transliteration Configuration
ENABLE_WORD_LEVEL=true
ENABLE_SENTENCE_LEVEL=true
MAX_SUGGESTIONS=10
DEFAULT_NUM_SUGGESTIONS=0


# Multi-tenant database (for tenant-specific schema routing)
# This is where transliteration request/result tables are stored in tenant schemas
MULTI_TENANT_DB_URL=postgresql+asyncpg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/multi_tenant_db
# Tenant Resolution Configuration
API_GATEWAY_URL=http://api-gateway-service:8080
TENANT_PATHS=/api/v1
MULTI_TENANT_ENABLED=true

# Model Management Configuration
MODEL_MANAGEMENT_SERVICE_URL=http://model-management-service:8091

# Telemetry/Tracing Configuration (AI4ICore Telemetry - OpenTelemetry/Jaeger)
JAEGER_ENDPOINT=http://jaeger:4317

USE_KAFKA_LOGGING=false