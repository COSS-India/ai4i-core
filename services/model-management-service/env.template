# Model Management Service environment template

SERVICE_NAME=model-management-service
SERVICE_PORT=8091
LOG_LEVEL=INFO

# Application database (model metadata)
APP_DB_USER=<POSTGRES_USER>
APP_DB_PASSWORD=<POSTGRES_PASSWORD>
APP_DB_HOST=<POSTGRES_HOST>
APP_DB_PORT=<POSTGRES_PORT>
APP_DB_NAME=<MODEL_MANAGEMENT_DB_NAME>

# Authentication database (shared auth schema)
AUTH_DB_USER=<POSTGRES_USER>
AUTH_DB_PASSWORD=<POSTGRES_PASSWORD>
AUTH_DB_HOST=<POSTGRES_HOST>
AUTH_DB_PORT=<POSTGRES_PORT>
AUTH_DB_NAME=<AUTH_DB_NAME>
AUTH_SERVICE_URL=http://auth-service:8081
JWT_ISSUER=auth-service
# JWT_AUDIENCE=
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# Authentication flags
AUTH_ENABLED=true
REQUIRE_API_KEY=true
ALLOW_ANONYMOUS_ACCESS=false

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Endpoint Validation
RUN_INFERENCE_TEST=true
# "lenient" = 4xx passes (server reachable), "strict" = 4xx fails
ENDPOINT_VALIDATION_MODE=lenient
# Timeout (seconds) for the live inference probe HTTP request
ENDPOINT_VALIDATION_TIMEOUT_SECONDS=30.0

# Model Versioning Configuration
MAX_ACTIVE_VERSIONS_PER_MODEL=5
ALLOW_DEPRECATED_MODEL_CHANGES=true


