# policy-engine — subscription plans, quotas, rate limits (port 8095)
#
# Same pattern as other services (e.g. multi-tenant-feature): keep secrets and
# service-specific vars in this folder.
#
#   cp env.template .env
#
# Compose loads ``./services/policy-engine/.env`` (see docker-compose-local.yml).
# ${POSTGRES_USER} etc. are expanded from the **repo root** .env when Compose parses
# env_file (Compose v2.24+). If not, use a full literal DATABASE_URL in ``.env``.
#
# Code reads these via ai4icore_env (app/database.py, app/billing_routes.py).

# Primary DB for policy-engine tables
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Multi-tenant-service base URL (plan service lists: /internal/service-configs/tier/{tier})
MULTI_TENANT_SERVICE_URL=http://multi-tenant-service:8001
