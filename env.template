# Global Environment Configuration
COMPOSE_PROJECT_NAME=ai4i-orchestrate
ENVIRONMENT=development

# Redis Configuration
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>

# InfluxDB Configuration
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=<YOUR_INFLUXDB_PASSWORD>
INFLUXDB_ORG=<YOUR_INFLUXDB_ORG>
INFLUXDB_BUCKET=metrics
INFLUXDB_ADMIN_TOKEN=<YOUR_INFLUXDB_TOKEN>

# Elasticsearch Configuration
ELASTIC_PASSWORD=<YOUR_ELASTIC_PASSWORD>
ELASTIC_USERNAME=elastic

# Kafka Configuration
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9092,PLAINTEXT_INTERNAL://kafka:29092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# Service URLs
AUTH_SERVICE_URL=http://auth-service:8081
JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
CONFIG_SERVICE_URL=http://config-service:8082
METRICS_SERVICE_URL=http://metrics-service:8083
TELEMETRY_SERVICE_URL=http://telemetry-service:8084
ALERTING_SERVICE_URL=http://alerting-service:8085
DASHBOARD_SERVICE_URL=http://dashboard-service:8086
ASR_SERVICE_URL=http://asr-service:8087
TTS_SERVICE_URL=http://tts-service:8088
NMT_SERVICE_URL=http://nmt-service:8089
MODEL_MANAGEMENT_SERVICE_URL=http://model-management-service:8091
UNLEASH_SERVICE_URL=http://unleash:4242

# Logging Configuration
LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARNING
EXCLUDE_HEALTH_LOGS=true
EXCLUDE_METRICS_LOGS=true
EXCLUDE_OPTIONS_LOGS=true
ALLOWED_LOG_LEVELS=INFO,ERROR
MIN_LOG_LEVEL=INFO
INCLUDE_4XX_LOGS=false

# Telemetry/Tracing Configuration (AI4ICore Telemetry - OpenTelemetry/Jaeger)
# Required: JAEGER_ENDPOINT must be set for distributed tracing to work
JAEGER_ENDPOINT=http://jaeger:4317
# Optional: Service version (can be overridden per-service)
SERVICE_VERSION=1.0.0
# Optional: Enable/disable telemetry plugin (default: true)
TELEMETRY_ENABLED=true

# Timezone
TZ=UTC

# Triton Inference Endpoints (used by model_management_default_seeder)
# Set these to the full callback URLs for each model/service.
TRITON_ENDPOINT_ASR=<YOUR_TRITON_ASR_ENDPOINT>
TRITON_ENDPOINT_TTS=<YOUR_TRITON_TTS_ENDPOINT>
TRITON_ENDPOINT_NMT=<YOUR_TRITON_NMT_ENDPOINT>
TRITON_ENDPOINT_LLM=<YOUR_TRITON_LLM_ENDPOINT>
TRITON_ENDPOINT_TRANSLITERATION=<YOUR_TRITON_TRANSLITERATION_ENDPOINT>
TRITON_ENDPOINT_LANGDETECT=<YOUR_TRITON_LANGDETECT_ENDPOINT>
TRITON_ENDPOINT_SPEAKER_DIARIZATION=<YOUR_TRITON_SPEAKER_DIARIZATION_ENDPOINT>
TRITON_ENDPOINT_AUDIO_LANGDETECT=<YOUR_TRITON_AUDIO_LANGDETECT_ENDPOINT>
TRITON_ENDPOINT_LANG_DIARIZATION=<YOUR_TRITON_LANG_DIARIZATION_ENDPOINT>
TRITON_ENDPOINT_OCR=<YOUR_TRITON_OCR_ENDPOINT>
TRITON_ENDPOINT_NER=<YOUR_TRITON_NER_ENDPOINT>

ASR_API_KEY=<YOUR_ASR_API_KEY>
AI4VOICE_API_KEY=<YOUR_AI4VOICE_API_KEY>
TTS_API_KEY=<YOUR_TTS_API_KEY>
NMT_API_KEY=<YOUR_NMT_API_KEY>
PIPELINE_API_KEY=<YOUR_PIPELINE_API_KEY>
DEVELOPER_API_KEY=<YOUR_DEVELOPER_API_KEY>
KONG_MANAGER_TOKEN_SECRET=<YOUR_KONG_MANAGER_TOKEN_SECRET>
MODEL_MANAGEMENT_API_KEY=<YOUR_MODEL_MANAGEMENT_API_KEY>

# Which gateway runs: set both to the same value (apisix or kong). COMPOSE_PROFILES starts only that gateway.
GATEWAY_PROVIDER=apisix
COMPOSE_PROFILES=apisix

# APISIX Local (Docker Compose): leave defaults or set APISIX_PUBLIC_ORIGIN=http://localhost:3000, APISIX_UPSTREAM_SUFFIX= (empty).
APISIX_PUBLIC_ORIGIN=http://localhost:3000
APISIX_UPSTREAM_SUFFIX=

MAX_ACTIVE_VERSIONS_PER_MODEL=2
ALLOW_DEPRECATED_MODEL_CHANGES=false

EXTERNAL_GPU_NER_URL=http://<your-external-gpu-ip>:9001
KAFKA_PII_AUDIT_TOPIC=pii_audit_logs

# Database Configuration
POSTGRES_USER=<YOUR_POSTGRES_USER>
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_HOST=<YOUR_POSTGRES_HOST>
POSTGRES_PORT=<YOUR_POSTGRES_PORT>
POSTGRES_DB=<YOUR_POSTGRES_DB>

# Individual Database Names
AUTH_DB_NAME=<YOUR_AUTH_DB_NAME>
MULTI_TENANT_DB_NAME=<YOUR_MULTI_TENANT_DB_NAME>
CONFIG_DB_NAME=<YOUR_CONFIG_DB_NAME>
MODEL_MANAGEMENT_DB_NAME=<YOUR_MODEL_MANAGEMENT_DB_NAME>
POLICY_DB_NAME=<YOUR_POLICY_DB_NAME>
DASHBOARD_DB_NAME=<YOUR_DASHBOARD_DB_NAME>
TELEMETRY_DB_NAME=<YOUR_TELEMETRY_DB_NAME>
METRICS_DB_NAME=<YOUR_METRICS_DB_NAME>
ALERTING_DB_NAME=<YOUR_ALERTING_DB_NAME>

# Policy-service DB connection (used by centralized Alembic migrations for policy_db)
POLICY_DB_USER=<YOUR_POSTGRES_USER>
POLICY_DB_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POLICY_DB_HOST=<YOUR_POSTGRES_HOST>
POLICY_DB_PORT=<YOUR_POSTGRES_PORT>

# Alembic/Migration Host & Port (for running migrations from host machine)
ALEMBIC_DB_HOST=<YOUR_ALEMBIC_DB_HOST>
ALEMBIC_DB_PORT=<YOUR_ALEMBIC_DB_PORT>
