# Root Environment Configuration
# Used exclusively by Docker Compose (docker-compose-local.yml) for infrastructure
# service configuration. Application services each have their own env.template.

COMPOSE_PROJECT_NAME=ai4i-orchestrate

# ── PostgreSQL ──
POSTGRES_USER=<YOUR_POSTGRES_USER>
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_DB=ai4i_platform_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full DSN — overrides individual fields above when set
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<YOUR_REDIS_PASSWORD>
REDIS_DB=0
REDIS_TIMEOUT=10
REDIS_MAX_CONNECTIONS=50

# ── Kafka ──
# Pre-filled with the correct default — no change needed unless you remap the host port.
# PLAINTEXT://localhost:<host-port> must match the host-mapped port (9093:9092 in compose).
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://localhost:9093,PLAINTEXT_INTERNAL://kafka:29092

# ── Kafka consumers ──
KAFKA_SERVER=localhost:9093
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_POLL_TIMEOUT_S=1.0
TOPIC_PAY_PER_USE=kafka-topic-otel-trace
PLATFORM_CORE_DB=

# ── Database names (used by Alembic migrations and service env generation) ──
AUTH_DB_NAME=ai4iplatform_auth
MODEL_MANAGEMENT_DB_NAME=ai4iplatform_core
ALEMBIC_DB_HOST=localhost
ALEMBIC_DB_PORT=5432

# ── LLM upstream (inference-service — only required for LLM task type) ──
LLM_UPSTREAM_BASE_URL= ""

# ── Grafana (optional — defaults to admin/admin) ──
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
