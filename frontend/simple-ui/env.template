# Simple UI environment template — copy to `.env` and adjust as needed.
#
# Only the vars listed here are read by the source code. Older releases also
# defined NEXT_PUBLIC_API_KEY / NEXT_PUBLIC_ENABLE_STREAMING /
# NEXT_PUBLIC_ENABLE_FEEDBACK / NEXT_PUBLIC_FEATURE_FLAG_* — those have been
# removed. The session API key flow is handled at runtime via the UI's
# session storage, not via env.

# ─────────────────────────────────────────────────────────────────────────────
# Server-side runtime config — read by the Next.js server /api/config and
# applied before the app renders. Change these via ConfigMap without rebuilding
# the image. Legacy NEXT_PUBLIC_* names for the same keys are still accepted.
# ─────────────────────────────────────────────────────────────────────────────

# API origin for client-side fetches. Requests to /api/v1/* are handled by the
# Next.js API route (src/pages/api/v1/[...proxy].ts), which proxies them to the
# appropriate backend service. Keep this pointing at the Next.js dev server.
# Empty ⇒ same-origin.
API_URL=http://localhost:3000

# Task types to request from platform APIs (comma-separated yaml names, e.g.
# "llm" or "llm,nmt,asr"). Also gates UI catalog (home, sidebar, logs,
# Service Management, Usage Dashboard). Unset/empty ⇒ full catalog.
ENABLED_TASK_TYPES=llm

# Product display name shown in UI titles, headers, etc. Unset/empty ⇒ AI Switch.
# Change via ConfigMap without rebuilding the image.
PLATFORM_NAME=AI Switch

# Instance logo: ADOPTER_LOGO_URL (http(s) or /path). Empty ⇒ default SVG.
# ADOPTER_LOGO_URL=

# Telemetry routes are served by platform-core-service behind the gateway.
# Leave EMPTY for local dev: same-origin /api/v1/telemetry/* flows through
# the Next.js API proxy (src/pages/api/v1/[...proxy].ts) → platform-core-service.
# Set this to an explicit URL only for Kubernetes/prod where the SPA is
# served from a different origin than the gateway.
TELEMETRY_SERVICE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Browser-side (NEXT_PUBLIC_*) — still inlined at build time. Keep these for
# WebSocket endpoints that the browser opens directly.
# ─────────────────────────────────────────────────────────────────────────────

# WebSocket endpoints for the streaming ASR / TTS demos. In Kubernetes set
# these to wss:// URLs on your external ingress.
NEXT_PUBLIC_ASR_STREAM_URL=ws://localhost:8087/socket.io/asr
NEXT_PUBLIC_TTS_STREAM_URL=ws://localhost:8088/socket.io/tts

# ─────────────────────────────────────────────────────────────────────────────
# Server-side proxy — read by the Next.js API route only (not /api/config).
#
# Dev setup: the Next.js API route at src/pages/api/v1/[...proxy].ts handles
# all /api/v1/* routing, forward-auth, and header injection directly — there
# is no separate gateway container to run.
#
# Minimum infrastructure to start: postgres + redis
#   docker compose -f docker-compose-local.yml up -d postgres redis
# Then run the three FastAPI services natively:
#   cd services/auth-service && uvicorn app.main:app --port 8081 --reload
#   cd services/platform-core-service && uvicorn app.main:app --port 8095 --reload
#   cd services/inference-service && python main.py
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode A: local backends (default) ──
# Per-service URLs the proxy routes to; it also does forward-auth + injects the
# X-User-ID/X-Tenant-ID/X-Permission-IDs/X-User-Plan headers these headerless
# local services expect. Leave DEV_BACKEND_ORIGIN (below) empty to use this mode.
AUTH_SERVICE_URL=http://localhost:8081
INFERENCE_SERVICE_URL=http://localhost:8090
PLATFORM_CORE_SERVICE_URL=http://localhost:8095

# ── Mode B: pass through to a deployed gateway (optional) ──
# Set this to hit a deployed backend (e.g. the dev portal) WITHOUT running any
# backend locally. When set, the proxy relays every /api/v1/* request verbatim to
# this origin and does NO forward-auth / NO identity-header injection — that
# gateway (APISIX) does auth + routing itself and rejects client-supplied identity
# headers. Browser stays same-origin, so there is no CORS. Keep API_URL
# empty when using this. Leave blank for Mode A above.
# DEV_BACKEND_ORIGIN=https://dev.ai4inclusion.org
