# AI4I-Orchestrator quick start: shared settings for every application container.
#
# LOCAL USE ONLY. Every secret below is a fixed, published value so the stack
# starts with no setup. Never reuse this file, or these values, anywhere that
# is reachable from another machine. All ports in docker-compose.yml are bound
# to 127.0.0.1 for the same reason.
#
# Each service reads only the variables it declares, so one shared file is safe.
# Per-service values (name, port) are set in docker-compose.yml.

ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
HOST=0.0.0.0
WORKERS=1
SERVICE_VERSION=quickstart
API_VERSION=v1
TELEMETRY_ENABLED=true
ENABLE_TELEMETRY=true
ENABLE_DOCS=true

# ── Branding ──
PLATFORM_NAME=AI4I Orchestrate
ADOPTER_LOGO_URL=
EMAIL_FROM_NAME=AI4I Orchestrate
NOTIFICATION_TIMEZONE=Asia/Kolkata

# ── Postgres (one instance, databases created by the migrate container) ──
POSTGRES_USER=ai4i
POSTGRES_PASSWORD=ai4i-quickstart
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DB_USER=ai4i
AUTH_DB_PASSWORD=ai4i-quickstart
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=ai4iplatform_auth
AUTH_SERVICE_DB_NAME=ai4iplatform_auth
AUTH_SERVICE_DB=ai4iplatform_auth
PLATFORM_CORE_DB_USER=ai4i
PLATFORM_CORE_DB_PASSWORD=ai4i-quickstart
PLATFORM_CORE_DB_HOST=postgres
PLATFORM_CORE_DB_PORT=5432
PLATFORM_CORE_DB_NAME=ai4iplatform_core
PLATFORM_CORE_DB=ai4iplatform_core
CORE_DB_NAME=ai4iplatform_core
CORE_SERVICE_DB_NAME=ai4iplatform_core
APP_DB_USER=ai4i
APP_DB_PASSWORD=ai4i-quickstart
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=ai4iplatform_core
AI4I_PLATFORM_DB_NAME=ai4i_platform_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ai4i-quickstart
REDIS_DB=0
REDIS_TIMEOUT=10

# ── Seeded accounts (read by the migrations) ──
ADMIN_DEFAULT_PASSWORD=Admin@12345
GUEST_EMAIL=guest@ai4inclusion.org
GUEST_PASSWORD=Guest@12345

# ── Shared secrets (local only, see the header) ──
PII_ENCRYPTION_KEY=1jEW/x3klbPdevr1tgPjTJV2o+MRMiBoGglXS5sTp76bUHf1Az33h24v5Vi+ofqCuaW31cxdSU34LgNj6se4Og==
SERVICE_CREDENTIALS_ENCRYPTION_KEY=ooQhEpjD6298n95wGjhZx7ylxyjyWI/93l8hzB/zyA4=
INTERNAL_SERVICE_SHARED_SECRET=N3DWuU3v7r95KOWUs8XIb6z1KHaxDUXobGOVbxOarI8=
MODEL_MANAGEMENT_SERVICE_INTERNAL_TOKEN=N3DWuU3v7r95KOWUs8XIb6z1KHaxDUXobGOVbxOarI8=

# ── Service-to-service URLs (container names on the quick start network) ──
AUTH_SERVICE_URL=http://auth-service:8081
MODEL_MANAGEMENT_SERVICE_URL=http://platform-core-service:8095
PORTAL_URL=http://localhost:8080
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:8080/auth/callback
SETUP_LINK_BASE_URL=http://localhost:8080/auth/set-password
VERIFY_LINK_BASE_URL=http://localhost:8080/auth/verify-email
RESET_LINK_BASE_URL=http://localhost:8080/auth/reset-password

# ── Model registration: the sample model runs on this private network ──
RUN_INFERENCE_TEST=true
ENDPOINT_VALIDATION_MODE=lenient
ENDPOINT_VALIDATION_ALLOW_PRIVATE_HOSTS=true
ENDPOINT_VALIDATION_SKIP_TLS_VERIFY=false
LLM_INFERENCE_TIMEOUT=60

# ── Metering: inference spans go through Kafka to the pay-per-use consumer ──
KAFKA_ENABLED=true
KAFKA_SERVER=kafka:9092
KAFKA_TOPIC_OTEL_TRACE=kafka-topic-otel-trace
TOPIC_PAY_PER_USE=kafka-topic-otel-trace
TOPIC_NOTIFICATION=notification.events
NOTIFICATION_PRODUCER_ENABLED=false
METERING_DATA_SOURCE=usage_events

# ── Observability ──
# Prometheus metrics at /enterprise/metrics (ai4i_core.observability, off by default).
OBSERVE_UTIL_ENABLED=true
OBSERVE_UTIL_METRICS_PATH=/enterprise/metrics
PROMETHEUS_URL=http://prometheus:9090
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=traces-*
OPENSEARCH_LOGS_INDEX=logs-*

# ── Features the quick start leaves out ──
# No Alertmanager and no email: alert sync is off and email has no SMTP host,
# so nothing tries to send mail.
ALERT_SYNC_ENABLED=false
EMAIL_PROVIDER=smtp
SMTP_HOST=
