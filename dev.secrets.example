# dev.secrets.example — local developer credential overrides.
#
# Copy this to `dev.secrets` (which is gitignored) and fill in the values you
# want. `scripts/dev/up` sources `dev.secrets` before bringing up the stack, so
# these become the credentials baked into the (gitignored) .env files that drive
# both the postgres/redis containers and every service.
#
#   cp dev.secrets.example dev.secrets
#   # edit dev.secrets, then:
#   ./scripts/dev/up core
#
# Nothing here is committed with real values. If you leave the passwords blank,
# `up` generates random local passwords instead — the stack still works, the
# values just differ per machine.
#
# You can equally pass any of these inline instead of using this file, e.g.:
#   AI4I_POSTGRES_PASSWORD=... ./scripts/dev/up core

# ── Postgres / Redis (local dev containers only — not real/shared secrets) ──
export AI4I_POSTGRES_USER=ai4i_user
export AI4I_POSTGRES_PASSWORD=
export AI4I_REDIS_PASSWORD=

# ── Alert email (SMTP / Amazon SES) — leave blank to keep alert email disabled ──
# These are REAL cloud credentials when set — keep them only in dev.secrets,
# never in env.template or any committed file.
export AI4I_SMTP_AUTH_USERNAME=
export AI4I_SMTP_AUTH_PASSWORD=
export AI4I_SMTP_SMARTHOST=
export AI4I_SMTP_FROM=

# ── Inference model (Triton) endpoints ──────────────────────────────────────
# Sensitive infra IPs — keep them ONLY here, never committed. The DB seed
# migration reads these env vars and writes them into mm_services.endpoint.
# IMPORTANT: the seed runs on a FRESH database (first `up`). If your DB already
# exists, reset it (./scripts/dev/down --prune) so the seed re-applies, or set
# the endpoints manually. Leave blank to seed empty endpoints (inference 500s).
export TRITON_ENDPOINT_NMT=
export TRITON_ENDPOINT_ASR=
export TRITON_ENDPOINT_TTS=
export TRITON_ENDPOINT_OCR=
export TRITON_ENDPOINT_NER=
export TRITON_ENDPOINT_LANGDETECT=
export TRITON_ENDPOINT_AUDIO_LANGDETECT=
export TRITON_ENDPOINT_TRANSLITERATION=
export TRITON_ENDPOINT_SPEAKER_DIARIZATION=
export TRITON_ENDPOINT_LANG_DIARIZATION=
export TRITON_ENDPOINT_LLM=

# inference-service's own LLM proxy upstream (distinct from TRITON_ENDPOINT_LLM).
# Injected into services/inference-service/.env as LLM_DEFAULT_ENDPOINT.
export AI4I_LLM_DEFAULT_ENDPOINT=
