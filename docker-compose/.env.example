# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Used by:
#   - docker compose (infra containers)
#   - scripts/setup-env.sh (synced into ai4i-core root .env, then per-service .env files)

COMPOSE_PROJECT_NAME=ai4i-infra

# ── Postgres (core) ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai4i_platform_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB_NAME=ai4iplatform_auth
MODEL_MANAGEMENT_DB_NAME=ai4iplatform_core
ALEMBIC_DB_HOST=localhost
ALEMBIC_DB_PORT=5432

# ── Redis (core) ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# ── Kafka KRaft (core) ────────────────────────────────────────────────────────
# Must stay fixed for the life of the kafka-data volume
KAFKA_CLUSTER_ID=evbOm0XBSEKL8QpMsHNG3Q
KAFKA_EXTERNAL_PORT=9092
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# Written to ai4i-core as KAFKA_SERVER=localhost:<KAFKA_EXTERNAL_PORT>
KAFKA_SERVER=localhost:9092

# ── etcd / APISIX (core) ──────────────────────────────────────────────────────
ETCD_PORT=2379
APISIX_HTTP_PORT=9080
APISIX_HTTPS_PORT=9443
APISIX_ADMIN_PORT=9180
APISIX_PROMETHEUS_PORT=9091
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# ── Branding (copied into service .env files by setup-env.sh) ─────────────────
PLATFORM_NAME=AI Switch
ADOPTER_LOGO_URL=

# ── Optional LLM upstream (inference-service) ─────────────────────────────────
LLM_UPSTREAM_BASE_URL=

# ── Monitoring (profile: monitoring) ──────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9095
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
NODE_EXPORTER_PORT=9100
KAFKA_EXPORTER_PORT=9308

# ── Logging (profile: logging) ────────────────────────────────────────────────
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx768m

# ── Network ───────────────────────────────────────────────────────────────────
COMPOSE_SUBNET=172.31.0.0/16
