# Copy to .env and adjust as needed:
#   cp .env.example .env
#
# Used by:
#   - docker compose (infra containers)
#   - scripts/setup-env.sh (synced into ai4i-core root .env, then per-service .env files)

COMPOSE_PROJECT_NAME=ai4i-infra

# ── Postgres (core) ───────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai4i_platform_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
AUTH_DB_NAME=ai4iplatform_auth
MODEL_MANAGEMENT_DB_NAME=ai4iplatform_core
ALEMBIC_DB_HOST=localhost
ALEMBIC_DB_PORT=5432

# ── Redis (core) ──────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# ── Kafka KRaft (core) ────────────────────────────────────────────────────────
# Must stay fixed for the life of the kafka-data volume
KAFKA_CLUSTER_ID=evbOm0XBSEKL8QpMsHNG3Q
KAFKA_EXTERNAL_PORT=9092
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
# Written to ai4i-core as KAFKA_SERVER=localhost:<KAFKA_EXTERNAL_PORT>
KAFKA_SERVER=localhost:9092

# ── etcd / APISIX (production gateway — NOT used in local uvicorn/UI setup) ───
ETCD_PORT=2379
APISIX_HTTP_PORT=9080
APISIX_HTTPS_PORT=9443
APISIX_ADMIN_PORT=9180
APISIX_PROMETHEUS_PORT=9091
APISIX_ADMIN_KEY=edd1c9f034335f136f87ad84b625c8f1

# ── Host apps (uvicorn — outside Compose) ─────────────────────────────────────
# Change these if preflight reports a busy port, then re-run setup-local.sh.
# setup-env.sh writes matching AUTH_SERVICE_URL / PLATFORM_CORE_SERVICE_URL /
# INFERENCE_SERVICE_URL into frontend/simple-ui/.env.
# Simple UI stays on :3000 (Next.js package.json). Grafana uses GRAFANA_PORT=3001.
AUTH_SERVICE_PORT=8081
PLATFORM_CORE_PORT=8095
INFERENCE_SERVICE_PORT=8090

# NMT Triton publish ports stay hardcoded 8000/8002 in setup-local.sh.
# Seed TRITON_ENDPOINT_NMT=http://127.0.0.1:8000 in the ai4i-core repo-root
# .env before migrations (SETUP-GUIDE Step 5) — not in this Compose .env.

# ── Branding (copied into service .env files by setup-env.sh) ─────────────────
PLATFORM_NAME=AI Switch
ADOPTER_LOGO_URL=

# ── Optional LLM upstream (inference-service) ─────────────────────────────────
LLM_UPSTREAM_BASE_URL=

# ── Monitoring (profile: monitoring) ──────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
ALERTMANAGER_PORT=9095
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
NODE_EXPORTER_PORT=9100
KAFKA_EXPORTER_PORT=9308

# ── Logging (profile: logging) ────────────────────────────────────────────────
OPENSEARCH_PORT=9200
OPENSEARCH_PERF_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx768m

# ── Network ───────────────────────────────────────────────────────────────────
# Must NOT overlap VPN/office routes (e.g. many VPNs claim 172.31.0.0/16 via tun0).
# If host→published ports hang (psql/migrate timeout) but `docker exec` works, change
# this subnet, then: docker compose down && docker compose up -d …
COMPOSE_SUBNET=172.28.0.0/16
