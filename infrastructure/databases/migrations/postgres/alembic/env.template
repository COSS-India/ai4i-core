# Copy this file to `alembic/.env` or provide the values in the project root `.env`.

# Dedicated auth database (auth-service-v2)
AUTH_DB_USER=<POSTGRES_USER>
AUTH_DB_PASSWORD=<POSTGRES_PASSWORD>
AUTH_DB_HOST=<ALEMBIC_DB_HOST>
AUTH_DB_PORT=<ALEMBIC_DB_PORT>
AUTH_DB_NAME=<AUTH_DB_NAME>

# New auth-service database; falls back to AUTH_DB_NAME then "ai4iplatform_auth" if unset
AUTH_SERVICE_DB_NAME=ai4iplatform_auth

# Model management database
APP_DB_USER=<POSTGRES_USER>
APP_DB_PASSWORD=<POSTGRES_PASSWORD>
APP_DB_HOST=<ALEMBIC_DB_HOST>
APP_DB_PORT=<ALEMBIC_DB_PORT>
APP_DB_NAME=<MODEL_MANAGEMENT_DB_NAME>

# Core service database (mm_models / mm_services in ai4iplatform_core schema)
# Falls back to shared POSTGRES_* vars if CORE_SERVICE_DB_* are unset.
CORE_SERVICE_DB_NAME=ai4iplatform_core

# Shared PostgreSQL connection settings for the remaining databases
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_HOST=<ALEMBIC_DB_HOST>
POSTGRES_PORT=<ALEMBIC_DB_PORT>

CONFIG_DB_NAME=<CONFIG_DB_NAME>
DASHBOARD_DB_NAME=<DASHBOARD_DB_NAME>
TELEMETRY_DB_NAME=<TELEMETRY_DB_NAME>
METRICS_DB_NAME=<METRICS_DB_NAME>
ALERTING_DB_NAME=<ALERTING_DB_NAME>
AI4I_PLATFORM_DB_NAME=<POSTGRES_DB>
POLICY_DB_NAME=<POLICY_DB_NAME>
