# Copy this file to `alembic/.env` or provide the values in the project root `.env`.

# Dedicated auth database
AUTH_DB_USER=<YOUR_POSTGRES_USER>
AUTH_DB_PASSWORD=<YOUR_POSTGRES_PASSWORD>
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db

# Model management database
APP_DB_USER=<YOUR_POSTGRES_USER>
APP_DB_PASSWORD=<YOUR_POSTGRES_PASSWORD>
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_NAME=model_management_db

# Multi-tenant database uses the APP_DB_* connection settings and its own name
MULTI_TENANT_DB_NAME=multi_tenant_db

# Shared PostgreSQL connection settings for the remaining databases
POSTGRES_USER=<YOUR_POSTGRES_USER>
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CONFIG_DB_NAME=config_db
DASHBOARD_DB_NAME=dashboard_db
TELEMETRY_DB_NAME=telemetry_db
METRICS_DB_NAME=metrics_db
ALERTING_DB_NAME=alerting_db
AI4I_PLATFORM_DB_NAME=ai4i_platform
