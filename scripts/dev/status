#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "$SCRIPT_DIR/lib/common.sh"
source "$SCRIPT_DIR/lib/pids.sh"

echo ""
echo "======== SERVICES ========"

for svc in \
    auth-service \
    platform-core-service \
    inference-service
do

    if is_running "$svc"
    then
        echo "✓ $svc"
    else
        echo "✗ $svc"
    fi

done

echo ""
echo "======== DOCKER ========"

docker ps --format "table {{.Names}}\t{{.Status}}"